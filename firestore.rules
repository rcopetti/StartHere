rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || true);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollection: trustedContacts
      match /trustedContacts/{contactId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && isValidId(contactId);
        allow update: if isSignedIn();
        allow delete: if isOwner(userId);
      }

      // Subcollection: sessions
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // High-priority alerts: alerts/{alertId}
    match /alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(alertId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && existing().seniorUid == request.auth.uid;
    }

    // Public curated lessons library: lessons/{lessonId}
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Scam checks history: scamChecks/{checkId}
    match /scamChecks/{checkId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(checkId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && existing().seniorUid == request.auth.uid;
    }
  }
}
