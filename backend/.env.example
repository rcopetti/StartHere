# ── Model provider ───────────────────────────────────────────────────────────
# One LiteLLM model string selects the backend.
#   Gemini:  gemini/gemini-2.5-flash                              (GEMINI_API_KEY)
#   Bedrock: bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0    (AWS_REGION_NAME + AWS keys)
#   Ollama:  ollama/llama3.2                                      (no key)
#   OpenAI:  openai/gpt-4o-mini                                   (OPENAI_API_KEY)
LLM_MODEL="gemini/gemini-2.5-flash"
# Optional provider prefix. A model without a prefix gets this one, so
# LLM_PROVIDER=bedrock + LLM_MODEL=anthropic.claude-3-5-sonnet-... also works.
LLM_PROVIDER=""
# Comma-separated models tried in order when the primary call fails.
LLM_FALLBACK_MODELS=""
# Only needed when the provider does not read its own environment variable.
LLM_API_KEY=""
LLM_API_BASE=""
LLM_TIMEOUT_SECONDS="20"
LLM_TEMPERATURE="0.1"
LLM_MAX_TOKENS="1200"
LLM_NUM_RETRIES="0"
LLM_MAX_REPAIR_ATTEMPTS="1"

# ── Firebase Authentication ──────────────────────────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_CREDENTIALS_JSON=""
# Local Auth emulator, e.g. 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=""

# ── Server ───────────────────────────────────────────────────────────────────
ENVIRONMENT="development"
LOG_LEVEL="INFO"
CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:4173"
MAX_TEXT_CHARS="20000"
MAX_FILE_BYTES="10485760"
MAX_PDF_PAGES="20"
# Requests per user per hour. Set to 0 to disable.
RATE_LIMIT_PER_HOUR="60"
