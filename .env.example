# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase web app configuration (client-visible values, loaded by Vite)
# Copy these into .env and replace each placeholder with the web app values
# from Firebase Console -> Project settings -> Your apps.
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="MY_FIREBASE_FIRESTORE_DATABASE_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="MY_FIREBASE_OAUTH_CLIENT_ID"

# Scam Check benchmark provider: gemini | ollama | heuristic
SCAMCHECK_AI_PROVIDER="gemini"
# Model name for the selected provider (Gemini: gemini-2.5-flash, Ollama: llama3.2)
SCAMCHECK_AI_MODEL="gemini-2.5-flash"
# Optional endpoint override. Ollama defaults to http://localhost:11434.
SCAMCHECK_AI_BASE_URL=""
# Request timeout in milliseconds
SCAMCHECK_AI_TIMEOUT_MS="60000"

# Scam Check API (FastAPI service in backend/).
# Leave blank to use the on-device check. Set it to route checks through the API,
# which requires the signed-in user's Firebase ID token.
VITE_API_BASE_URL=""
